# LLM Provider: mock | anthropic
GATELLM_PROVIDER=mock

# Required only when GATELLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Dev API Key Hash (for "gk-test-key-1")
# Generate hash: echo -n "gk-test-key-1" | sha256sum | cut -d' ' -f1
GATELLM_DEV_KEY_HASH=38ad893cf09cdbb34d77e1e4418c9fcbe7848bb66ae3a7d4fdc07d513aacd065

# Optional overrides (uncomment to use)
# GATELLM_MAX_OUTPUT_TOKENS=1024
# GATELLM_RATE_LIMIT_PER_MINUTE=10
# GATELLM_DAILY_TOKEN_BUDGET=100000
# GATELLM_MOCK_FAILURE_RATE=0.0
# GATELLM_MOCK_LATENCY_MS=200